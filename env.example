# API Config
HOST=luna
PORTHUB_MODE=prod
# Build-time Cargo jobs per stage; lower this on shared/small build hosts.
PORTHUB_BUILD_JOBS=4
PORTHUB_API_SOCKET=/run/porthub-api/api.sock
PORTHUB_EDGE_SOCKET=/run/porthub-edge/control.sock
PORTHUB_EDGE_HTTP_LISTEN=0.0.0.0:80,0.0.0.0:8345
PORTHUB_EDGE_TLS_LISTEN=0.0.0.0:443,0.0.0.0:8346
PORTHUB_ALLOW_SELF_SIGNED=true
API_SECRET_KEY=change-me-generate-a-long-random-value
SESSION_COOKIE_NAME=porthub_session
PORTHUB_CLIENT_BINARY_DIR=/app/client-bin
SIGNUP_DISABLED=false
APP_HTTP_PORT=8345
APP_HTTPS_PORT=8346
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
WEB_PROXY_DOMAIN_SUFFIX=luna.lan
PORT_HUB_PUBLIC_BASE_URL=https://porthub.example.com
# Comma-separated alternative URLs of this same server; HTTP is supported.
PORT_HUB_FALLBACK_BASE_URLS=
# Optional direct HTTPS origin, reached with its canonical Host and a key pin.
PORT_HUB_DIRECT_HTTPS_BASE_URL=
PORTHUB_GATEWAY_CONFIG_PATH=/run/porthub-config/gateway.toml
PORTHUB_WEB_ROUTES_CONFIG_PATH=/run/porthub-config/web-routes.json
PORTHUB_WEB_ACTIVITY_LOG_PATH=/run/porthub-activity/web-activity.log
# Preferred authoritative external endpoint: scheme + public host + forwarded port.
# Examples: https://origin.example.com:18446 or http://203.0.113.10:18345
# Independent of the HTTPS public API domain and internal HTTP/TLS listeners.
# Forward the advertised port to the matching edge listener (HTTP 8345 / TLS 8346).
# Returned only to authenticated clients; API and tunnel share the edge ports.
# This overrides the IP-only option and skips automatic IP discovery.
PORTHUB_GATEWAY_ADVERTISED_URL=
# Legacy authoritative IPv4-only override; uses the edge TLS listener port.
# Set this to choose a public/private routed address without external IP lookup.
# Leave both overrides empty to enable cached automatic public-IP discovery.
PORTHUB_GATEWAY_PUBLIC_IP=
PORTHUB_GATEWAY_IP_SOURCES=https://api.ipify.org,https://checkip.amazonaws.com
PORT_HUB_SERVICE_DOMAIN=luna.lan
MACHINE_CONFIG_LONG_POLL_TIMEOUT_SECONDS=25
MACHINE_ONLINE_TTL_SECONDS=300
MACHINE_OFFLINE_ALERT_GRACE_SECONDS=60
MACHINE_CONFIG_LONG_POLL_INTERVAL_SECONDS=1.0
EXTERNAL_PORT_RANGE_START=10000
EXTERNAL_PORT_RANGE_END=50000
FIREWALL_SOCKET=/run/porthub-firewall/api.sock
FIREWALL_API_KEY=change-me-generate-a-long-random-value
FIREWALL_REQUEST_TIMEOUT_SECONDS=5

# Firewall Service Config
FW_API_KEY=change-me-generate-a-long-random-value
FW_DB_PATH=/data/firewall/firewall.db
FW_BUFFER_SECONDS=300
FW_ACTIVE_TTL=300
FW_RECENT_IP_TTL=300
FW_RECENT_IP_HISTORY_LIMIT=10
FW_NFT_TABLE=inet porthub

# Database Config
MONGO_INITDB_ROOT_USERNAME=porthub
MONGO_INITDB_ROOT_PASSWORD=change-me-generate-a-long-random-value
MONGO_DATABASE_NAME=porthub
MONGO_DATABASE_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@127.0.0.1:47017/${MONGO_DATABASE_NAME}?authSource=admin
