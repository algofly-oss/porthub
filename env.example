# API Config
HOST=luna
API_NUM_WORKERS=4
API_SECRET_KEY=change-me-generate-a-long-random-value
SESSION_COOKIE_NAME=porthub_session
SIGNUP_DISABLED=false
APP_HTTP_PORT=8345
APP_HTTPS_PORT=8346
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
WEB_PROXY_DOMAIN_SUFFIX=luna.lan
RATHOLE_PORT=2334
PORT_HUB_PUBLIC_BASE_URL=http://luna.lan
PORT_HUB_SERVICE_DOMAIN=luna.lan
RATHOLE_SERVER_ADDRESS=luna.local:2334
RATHOLE_RELEASE_GITHUB_REPOSITORY=rathole-org/rathole
RATHOLE_RELEASE_GITHUB_API_URL=https://api.github.com
RATHOLE_SERVER_CONFIG_PATH=/runtime/rathole/server.toml
RATHOLE_RELEASE_CACHE_DIR=/tmp/porthub/rathole-downloads
RATHOLE_RELEASE_CACHE_TTL_SECONDS=86400
RATHOLE_DUMMY_SERVICE_NAME=dummy
RATHOLE_DUMMY_SERVICE_TOKEN=change-me-generate-a-long-random-value
RATHOLE_DUMMY_SERVICE_BIND_ADDR=127.0.0.1:65535
MACHINE_CONFIG_LONG_POLL_TIMEOUT_SECONDS=25
MACHINE_CONFIG_LONG_POLL_INTERVAL_SECONDS=1.0
EXTERNAL_PORT_RANGE_START=10000
EXTERNAL_PORT_RANGE_END=50000
FIREWALL_BASE_URL=http://host.docker.internal:8001/api
FIREWALL_API_KEY=porthub-firewall-dev-key
FIREWALL_REQUEST_TIMEOUT_SECONDS=5

# Firewall Service Config
FW_API_KEY=change-me-generate-a-long-random-value
FW_DB_PATH=/state/firewall.db
FW_BUFFER_SECONDS=300
FW_ACTIVE_TTL=300
FW_RECENT_IP_TTL=300
FW_RECENT_IP_HISTORY_LIMIT=10
FW_NFT_TABLE=inet rathole
FW_HOST=0.0.0.0
FW_PORT=8001
FW_NUM_WORKERS=2

# UI Config
UI_ADDRESS=ui:3000
API_ADDRESS=api:8080

# Redis Config

# Database Config
MONGO_INITDB_ROOT_USERNAME=porthub
MONGO_INITDB_ROOT_PASSWORD=change-me-generate-a-long-random-value
MONGO_DATABASE_NAME=porthub
MONGO_DATABASE_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/${MONGO_DATABASE_NAME}?authSource=admin
